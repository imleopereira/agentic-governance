"""Governance SDK wiring for this agent.

Reads ``DATABASE_URL`` from the environment. Kept in its own module so
you can unit-test the governance wiring without spinning up the full AGT
agent loop.

To dual-write audit events and HITL approvals to a hosted platform, set
``platform_bridge_enabled=True`` along with both ``platform_ingest_url``
and ``platform_ingest_token``. Local Postgres stays the source of truth:
the host app keeps working if the platform is unreachable.
"""
from __future__ import annotations

import os

from codeatelier_governance import GovernanceSDKSync


def make_sdk() -> GovernanceSDKSync:
    """Construct a governance SDK from environment-driven configuration.

    Returned unstarted — use it as a context manager::

        with make_sdk() as sdk:
            ...
    """
    return GovernanceSDKSync(
        database_url=os.environ.get(
            "DATABASE_URL", "postgresql://localhost/governance"
        ),
        # Uncomment to dual-write audit + gates to a hosted platform:
        # platform_bridge_enabled=True,
        # platform_ingest_url=os.environ["GOVERNANCE_PLATFORM_URL"],
        # platform_ingest_token=os.environ["GOVERNANCE_PLATFORM_TOKEN"],
    )
