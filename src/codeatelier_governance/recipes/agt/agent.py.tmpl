def refund_customer(
    sdk: GovernanceSDKSync, customer_id: str, amount_usd: float
) -> dict[str, object]:
    """Issue a refund — every governance gate fires BEFORE the side effect."""
    session_id = uuid.uuid4()

    # 1) scope check — is this tool even allowed for this agent?
    sdk.scope.check(AGENT_ID, tool="refund.issue")

    # 2) cost check — has this agent's session budget been exhausted?
    sdk.cost.check_or_raise(AGENT_ID, session_id)

    # 3) gate — for anything over $1k, block on a human decision. wait_for
    #    returns once the request is granted, or raises ApprovalDenied. A
    #    human approves out of band by calling sdk.gates.grant(req.token).
    if amount_usd >= 1000:
        req = sdk.gates.request(
            "refund.issue",
            AGENT_ID,
            payload={"customer_id": customer_id, "amount_usd": amount_usd},
        )
        try:
            sdk.gates.wait_for(req.request_id, timeout=300)
        except ApprovalDenied:
            return {"ok": False, "reason": "refund denied by reviewer"}

    # 4) actually issue the refund (stub — replace with your own logic).
    return {"ok": True, "refunded": amount_usd, "customer_id": customer_id}


def main() -> int:
    """Entry point.

    Expects ``DATABASE_URL`` to point at the governance Postgres (already
    migrated with ``governance migrate``). For a quick smoke run against a
    local database::

        DATABASE_URL=postgresql://localhost/governance python agent.py
    """
    if "DATABASE_URL" not in os.environ:
        print("Set DATABASE_URL before running. See .env.example.")
        return 2

    with make_sdk() as sdk:
        # Declare what this agent may do (tools are default-deny otherwise).
        sdk.scope.register(
            ScopePolicy(agent_id=AGENT_ID, allowed_tools=frozenset({"refund.issue"}))
        )
        sdk.cost.register(BudgetPolicy(agent_id=AGENT_ID, per_session_usd=5.00))

        result = refund_customer(sdk, customer_id="cust_123", amount_usd=42.0)
    print(result)
    return 0


