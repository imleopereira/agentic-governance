def refund_customer(customer_id: str, amount_usd: float) -> dict[str, object]:
    """Issue a refund — every governance gate fires BEFORE the side effect."""
    sdk = make_sdk(AGENT_ID)

    # 1) scope check — is this tool even allowed for this agent?
    sdk.scope.check(AGENT_ID, tool="refund.issue")

    # 2) cost preflight — would this action exceed the configured budget?
    sdk.cost.preflight(
        agent_id=AGENT_ID,
        kind="refund.issue",
        estimated_cost_usd=amount_usd,
    )

    # 3) gate — for anything over $1k, block on a human decision.
    if amount_usd >= 1000:
        req = sdk.gates.request(
            agent_id=AGENT_ID,
            kind="refund.issue",
            action_preview={"customer_id": customer_id, "amount_usd": amount_usd},
            risk="critical" if amount_usd >= 10_000 else "high",
        )
        decision = sdk.gates.wait_for(req.request_id, timeout=300)
        if decision != "granted":
            raise RuntimeError(f"refund denied: {decision}")

    # 4) actually issue the refund (stub — replace with your own logic).
    return {"ok": True, "refunded": amount_usd, "customer_id": customer_id}


def main() -> int:
    """Entry point.

    Expects ``DATABASE_URL`` to point at the governance Postgres. For a
    quick smoke run against a local database::

        DATABASE_URL=postgresql://localhost/governance python agent.py
    """
    if "DATABASE_URL" not in os.environ:
        print("Set DATABASE_URL before running. See .env.example.")
        return 2

    result = refund_customer(customer_id="cust_123", amount_usd=42.0)
    print(result)
    return 0


