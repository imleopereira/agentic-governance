"""{agent_id} — internal-research agent starter.

{description}

Generated by ``governance init agent-internal-research`` on {generated_at}.
Edit the three ``# TODO`` markers below to wire this agent into your stack.
"""
from __future__ import annotations

import argparse
import asyncio
import os
import sys
from uuid import uuid4

from codeatelier_governance import (
    BudgetPolicy,
    GovernanceSDK,
    ScopePolicy,
)
from codeatelier_governance.audit.models import AuditEvent

AGENT_ID = "{agent_id}"

# TODO: keep the tool whitelist narrow — research agents only need read paths.
SCOPE = ScopePolicy(
    agent_id=AGENT_ID,
    allowed_tools=frozenset({{"search_docs", "summarize", "cite"}}),
)

# TODO: extend the daily cap only after one representative query batch.
BUDGET = BudgetPolicy(
    agent_id=AGENT_ID,
    per_session_usd=1.00,
    per_agent_usd_daily=15.0,
)


async def run(*, smoke: bool) -> int:
    """Answer one research query. ``smoke`` short-circuits before any IO."""
    if smoke:
        sys.stdout.write(f"{{AGENT_ID}}: smoke OK (scope + budget constructed)\n")
        return 0

    database_url = os.environ["GOVERNANCE_DATABASE_URL"]
    async with GovernanceSDK(database_url=database_url) as sdk:
        sdk.scope.register(SCOPE)
        sdk.cost.register(BUDGET)
        await sdk.audit.log(
            AuditEvent(
                session_id=uuid4(),
                agent_id=AGENT_ID,
                kind="agent.start",
                metadata={{"recipe": "internal-research"}},
            )
        )
        # TODO: retrieve, rank, cite — log every source hash to sdk.audit
        # so your compliance officer can reconstruct provenance later.
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=f"Run the {{AGENT_ID}} agent")
    parser.add_argument("--smoke", action="store_true", help="Construct + exit 0")
    args = parser.parse_args()
    return asyncio.run(run(smoke=bool(args.smoke)))


if __name__ == "__main__":
    raise SystemExit(main())
