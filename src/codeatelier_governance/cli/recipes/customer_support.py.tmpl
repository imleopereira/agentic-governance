from __future__ import annotations

import argparse
import asyncio
import os
import sys
from uuid import uuid4

from codeatelier_governance import (
    BudgetPolicy,
    GovernanceSDK,
    ScopePolicy,
)
from codeatelier_governance.audit.models import AuditEvent

AGENT_ID = "{agent_id}"

# TODO: curate the tool whitelist your agent is actually allowed to call.
SCOPE = ScopePolicy(
    agent_id=AGENT_ID,
    allowed_tools=frozenset({{"lookup_order", "issue_refund", "send_email"}}),
)

# TODO: right-size the per-session + per-day caps for your production traffic.
BUDGET = BudgetPolicy(
    agent_id=AGENT_ID,
    per_session_usd=0.50,
    per_agent_usd_daily=25.0,
)


async def run(*, smoke: bool) -> int:
    """Drive a single support turn. ``smoke`` short-circuits before any IO."""
    if smoke:
        # Construct policies to prove the file is wired correctly without
        # requiring a live Postgres. Exit 0 so CI can gate on this path.
        sys.stdout.write(f"{{AGENT_ID}}: smoke OK (scope + budget constructed)\n")
        return 0

    database_url = os.environ["GOVERNANCE_DATABASE_URL"]
    async with GovernanceSDK(database_url=database_url) as sdk:
        sdk.scope.register(SCOPE)
        sdk.cost.register(BUDGET)
        await sdk.audit.log(
            AuditEvent(
                session_id=uuid4(),
                agent_id=AGENT_ID,
                kind="agent.start",
                metadata={{"recipe": "customer-support"}},
            )
        )
        # TODO: drive your LLM + tool loop here; every call flows through
        # ``sdk.scope.check(...)``, ``sdk.cost.check(...)`` and
        # ``sdk.audit.log(...)`` so enforcement + evidence ride together.
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=f"Run the {{AGENT_ID}} agent")
    parser.add_argument("--smoke", action="store_true", help="Construct + exit 0")
    args = parser.parse_args()
    return asyncio.run(run(smoke=bool(args.smoke)))


if __name__ == "__main__":
    raise SystemExit(main())
